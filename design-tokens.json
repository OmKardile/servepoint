{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "TSOS Design System Tokens",
  "version": "1.0.0",
  "archetype": "Warm Bakery & Specialty Cafe POS",
  "tokens": {
    "color": {
      "background": { "value": "#FFF9F2", "type": "color", "comment": "Warm cream page background" },
      "surface": { "value": "#FFFFFF", "type": "color", "comment": "Pure white card & modal surface" },
      "surfaceSecondary": { "value": "#F5F0EB", "type": "color", "comment": "Subtle cream for hover/nested containers" },
      "divider": { "value": "#E9E0D6", "type": "color", "comment": "Warm border and dividing lines" },
      "action": { "value": "#F97316", "type": "color", "comment": "Vibrant terracotta orange for primary actions" },
      "actionHover": { "value": "#EA580C", "type": "color", "comment": "Deep orange hover state" },
      "actionSoft": { "value": "#FFF1E6", "type": "color", "comment": "Light orange tint for active chips/badges" },
      "completed": { "value": "#17803D", "type": "color", "comment": "Rich forest green for paid & completed orders" },
      "completedSoft": { "value": "#E8F5EC", "type": "color", "comment": "Soft herbal green for success alerts" },
      "attention": { "value": "#B45309", "type": "color", "comment": "Warm amber for preparing status & low stock" },
      "attentionSoft": { "value": "#FFF4E5", "type": "color", "comment": "Light amber tint" },
      "destructive": { "value": "#B42318", "type": "color", "comment": "Crimson red for cancellations & errors" },
      "destructiveSoft": { "value": "#FEF2F2", "type": "color", "comment": "Light crimson tint" },
      "info": { "value": "#2563EB", "type": "color", "comment": "Cobalt blue for notifications & online orders" },
      "infoSoft": { "value": "#EFF6FF", "type": "color", "comment": "Soft blue tint" },
      "accent": { "value": "#7C3AED", "type": "color", "comment": "Royal violet for loyalty rewards & VIP tiers" },
      "accentSoft": { "value": "#F5F3FF", "type": "color", "comment": "Soft purple tint" },
      "textPrimary": { "value": "#1C1917", "type": "color", "comment": "Warm espresso dark for high contrast text" },
      "textSecondary": { "value": "#57534E", "type": "color", "comment": "Warm charcoal for secondary metadata" },
      "textMuted": { "value": "#A8A29E", "type": "color", "comment": "Warm stone for placeholders & disabled states" }
    },
    "typography": {
      "fontFamily": {
        "display": "Plus Jakarta Sans, system-ui, sans-serif",
        "body": "Inter, system-ui, -apple-system, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "fontSize": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px",
        "4xl": "36px"
      }
    },
    "spacing": {
      "unit": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px"
    },
    "borderRadius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "full": "9999px"
    }
  }
}
